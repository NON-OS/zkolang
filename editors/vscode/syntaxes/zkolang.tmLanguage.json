{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "zKolang",
  "scopeName": "source.zkolang",
  "fileTypes": ["zkl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.zkolang"
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(let|const|fn|input|secret|output|assert|for|in|if|else)\\b",
          "name": "keyword.control.zkolang"
        },
        {
          "match": "\\b(inv|sel)\\b",
          "name": "support.function.builtin.zkolang"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "entity.name.function.zkolang" } }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.zkolang"
        }
      ]
    },
    "numbers": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.zkolang"
    },
    "operators": {
      "match": "==|!=|&&|\\|\\||\\.\\.|[+\\-*/=!]",
      "name": "keyword.operator.zkolang"
    }
  }
}
