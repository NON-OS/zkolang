// A confidential transfer: spend one note and create another, conserving value, in one
// circuit. The spender proves an input note sits under the public root and retires it
// with a nullifier, then forms an output note whose value is the input value less the
// public fee, range proven so no value is minted. The input value, both keys, and the
// blinding stay private; a verifier learns the nullifier retired, the output note
// created, and that value was conserved, no amount revealed.
// Run: zkolang circuits/shield/transfer_note.zkl
include "hash.zkl";
include "merkle.zkl";
include "bits.zkl";

witness in_value;
witness in_key;
witness s0; witness s1; witness s2;
witness p0; witness p1; witness p2;
public root;
public position;
public fee;
witness out_key;
witness out_blind;

// The input note authenticates to the public root along its path.
let note = permute(in_value + in_key);
let sib = [s0, s1, s2];
let pb = [p0, p1, p2];
let node = note;
for lvl in 0 .. 3 {
    let node = merkle_step(node, sib[lvl], pb[lvl]);
}
prove node - root;

// The nullifier retires the input note.
reveal permute(in_key + position);

// Value is conserved: the output value is the input less the fee, range proven a byte,
// which is unprovable when the fee exceeds the input.
let out_value = in_value - fee;
secret o0; secret o1; secret o2; secret o3;
secret o4; secret o5; secret o6; secret o7;
prove bit(o0); prove bit(o1); prove bit(o2); prove bit(o3);
prove bit(o4); prove bit(o5); prove bit(o6); prove bit(o7);
prove out_value - compose8(o0, o1, o2, o3, o4, o5, o6, o7);

// The output note commits the output value under the recipient key and a fresh blinding.
let onote = permute(out_value + out_key);
reveal permute(onote + out_blind);
