// SCOPE: a demonstration of the language, not the deployed Shield protocol. This
// builds its note and its tree from the standard library's MiMC permutation over a
// short path. The pool commits notes with the thirty two round Poseidon over eleven
// limbs (see note_commit.zkl) and authenticates them against a depth thirty two
// tree, so nothing here interoperates with a real note. Read it for the language,
// not for the protocol.
// The commitment-tree root a note authenticates to, given its opening and path. This is
// the companion that computes the public root a spend proves against: the note is the
// commitment to a value under a key, folded up a depth-three path of siblings ordered by
// the path bits. Run: zkolang circuits/shield/note_root.zkl
include "hash.zkl";
include "merkle.zkl";

witness value;
witness key;
witness s0; witness s1; witness s2;
witness p0; witness p1; witness p2;

let note = permute(value + key);

let sib = [s0, s1, s2];
let pb = [p0, p1, p2];
let node = note;
for lvl in 0 .. 3 {
    let node = merkle_step(node, sib[lvl], pb[lvl]);
}
reveal node;
