// A boot measurement chain, the shape a platform configuration register extends. Each
// stage measurement is folded into the running root and permuted, so the final root
// commits to the whole boot sequence in order. A later attestation compares this root
// against a trusted value to decide whether the platform booted a known chain.
// Run: zkolang kernel/measure_root.zkl
include "hash.zkl";

public m0;
public m1;
public m2;
public m3;

let ms = [m0, m1, m2, m3];
let root = 0;
for k in 0 .. 4 {
    let root = permute(root + ms[k]);
}
reveal root;
