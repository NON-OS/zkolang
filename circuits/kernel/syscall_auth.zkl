// A syscall authorization. A capsule presents a capability token; the circuit proves the
// token is the broker's MiMC binding of the capsule id and the requested syscall number,
// so a forged token has no proof and the kernel admits only authorized calls.
// Run: zkolang kernel/syscall_auth.zkl
include "hash.zkl";
public capsule_id;
public syscall;
public token;
witness broker_key;
let t = broker_key + capsule_id;
for i in 0 .. 8 { let t = mimc_round(t, MIMC_C[i]); }
let t = t + syscall;
for i in 8 .. 16 { let t = mimc_round(t, MIMC_C[i]); }
prove t - token;
reveal syscall;
