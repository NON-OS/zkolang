// A spend proof that ties membership to a nullifier. The prover shows a note commitment
// sits under the public root by folding it up a depth three path, and publishes the
// note's nullifier from the secret key. Presence authorizes the spend; the nullifier
// prevents spending it twice, and neither reveals which leaf was spent.
// Run: zkolang shield/membership_and_nullifier.zkl
include "hash.zkl";
include "merkle.zkl";

input leaf;
input s0; input s1; input s2;
input p0; input p1; input p2;
secret sk;

let sib = [s0, s1, s2];
let pb = [p0, p1, p2];
let node = leaf;
for lvl in 0 .. 3 {
    let node = merkle_step(node, sib[lvl], pb[lvl]);
}
output node;

output permute(sk + leaf);
