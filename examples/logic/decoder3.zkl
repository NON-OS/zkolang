// A three to eight decoder. Three address bits select exactly one of eight output
// lines, the one whose index equals the address, by forming for each line the product
// of the address bits matched against that line's binary pattern. Exactly one output is
// one. Run: zkolang logic/decoder3.zkl
include "logic.zkl";

input s0; input s1; input s2;
assert is_bit(s0); assert is_bit(s1); assert is_bit(s2);

let n0 = not(s0); let n1 = not(s1); let n2 = not(s2);
output n2 * n1 * n0;
output n2 * n1 * s0;
output n2 * s1 * n0;
output n2 * s1 * s0;
output s2 * n1 * n0;
output s2 * n1 * s0;
output s2 * s1 * n0;
output s2 * s1 * s0;
