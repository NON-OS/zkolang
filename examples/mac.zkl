// A message authentication code from the MiMC permutation: the key and message are
// absorbed together and permuted, so only a holder of the secret key can produce the
// tag, and the tag binds the message. Run: zkolang mac.zkl
include "hash.zkl";

secret key;
input msg;

let s = key + msg;
for i in 0 .. 16 {
    let s = mimc_round(s, MIMC_C[i]);
}
output s;
