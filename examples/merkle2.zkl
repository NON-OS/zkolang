// A two-to-one compression, the node of a hash tree. Two children are folded into one
// field element by the MiMC compression, so a proof over this program attests a correct
// internal node. Depth comes from composing this step, which the memory extension will
// make direct. Run: zkolang merkle2.zkl
include "merkle.zkl";

input left;
input right;

output compress2(left, right);
