// MiMC permutation over Goldilocks, x^7 S-box, 16 rounds. The round constants and the
// round function come from the standard library, so this shows the permutation as a fold
// of the shared primitive rather than redefining it. Run: zkolang mimc.zkl
include "hash.zkl";

input x;
let s = x;
for i in 0 .. 16 {
    let s = mimc_round(s, MIMC_C[i]);
}
output s;
