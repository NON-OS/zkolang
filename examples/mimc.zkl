// MiMC permutation over Goldilocks, x^7 S-box, 16 rounds.
// The round constants are a fixed Weyl sequence. Generated by gen_mimc.
const C = [11400714819323198485, 16088033396387240378, 18339175128185271363, 6250726733345258880, 860606576581593985, 211947541457481110, 4899937286522103119, 4031048130325877628, 11455035227444029741, 1701577562105719986, 2115931002410623643, 7476793921636051640, 3314512000073146649, 3439479947032908558, 17443250021448620071, 13023377555915530036];

// The x^7 S-box, a permutation of the field.
fn pow7(x) = x * x * x * x * x * x * x;

input x;
let s = x;
for i in 0 .. 16 {
    let s = pow7(s + C[i]);
}
output s;
