// A two block MiMC sponge: the state absorbs the first input, is permuted, absorbs the
// second, is permuted again, and the state is squeezed as the digest. This hashes an
// arbitrary length message by absorbing one block at a time between permutations.
// Run: zkolang sponge2.zkl
include "hash.zkl";

input x0;
input x1;

let s = permute(x0);
output permute(s + x1);
