// The product of two two by two matrices, each held row major in a constant table, with
// the four entries of the product as public outputs. Run: zkolang matmul2.zkl
const A = [1, 2,
           3, 4];
const B = [5, 6,
           7, 8];
output A[0] * B[0] + A[1] * B[2];
output A[0] * B[1] + A[1] * B[3];
output A[2] * B[0] + A[3] * B[2];
output A[2] * B[1] + A[3] * B[3];
