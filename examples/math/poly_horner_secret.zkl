// Prove knowledge of a root of a public polynomial. The coefficients are public, the
// candidate root is a private witness, and the circuit asserts the polynomial evaluates
// to zero there. A verifier learns that the prover knows a root without learning which.
// Run: zkolang math/poly_horner_secret.zkl
const A = [1, 0, 0, 0, 0, 0, 0, 0];
secret r;
let acc = 0;
for i in 0 .. 8 {
    let acc = acc * r + A[i];
}
assert acc;
output r * r;
