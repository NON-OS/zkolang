// Evaluate a degree seven polynomial at a point by Horner's method. The eight
// coefficients sit in a constant table from the highest degree down, and the loop folds
// them into the running value, one multiply and add per coefficient, so a degree seven
// evaluation costs seven multiplies. Run: zkolang math/horner8.zkl
const A = [3, 1, 4, 1, 5, 9, 2, 6];
input x;
let acc = 0;
for i in 0 .. 8 {
    let acc = acc * x + A[i];
}
output acc;
