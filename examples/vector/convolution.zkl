// A one dimensional convolution of a length four signal with a length three kernel,
// producing the two valid output positions where the kernel fully overlaps the signal.
// The kernel sits in a constant table; the signal is the input. Run: zkolang vector/convolution.zkl
const K = [1, 2, 1];
input x0; input x1; input x2; input x3;
let x = [x0, x1, x2, x3];
output x[0] * K[0] + x[1] * K[1] + x[2] * K[2];
output x[1] * K[0] + x[2] * K[1] + x[3] * K[2];
