// A wide two-to-one compression: two field elements fold into one over sixteen rounds,
// absorbing the first through eight rounds, mixing in the second, and finishing the last
// eight. This is the shared compress_wide gadget the kernel's syscall token also uses; the
// Merkle examples fold with the lighter compress2. Run: zkolang hash/compress.zkl
include "hash.zkl";

input left;
input right;

output compress_wide(left, right);
