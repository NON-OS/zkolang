// A keyed pseudorandom function: the key and the input index are absorbed and permuted,
// so the output is a deterministic, key dependent field element that looks random to
// anyone without the key. The stream a counter mode expansion draws from.
// Run: zkolang hash/keyed_prf.zkl
include "hash.zkl";

secret key;
input counter;
let s = key + counter;
for i in 0 .. 16 { let s = mimc_round(s, MIMC_C[i]); }
output s;
