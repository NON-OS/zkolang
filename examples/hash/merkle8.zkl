// Membership in a depth eight Merkle tree, a tree over two hundred fifty six leaves.
// Same structure as the shallower paths, eight levels deep: at each level the current
// node is paired with the given sibling in the order the path bit dictates and folded
// through the compression. A single proof over this program attests a leaf's presence
// under a public root with an eight step authentication path. Run: zkolang hash/merkle8.zkl
include "merkle.zkl";

input leaf;
input s0; input s1; input s2; input s3; input s4; input s5; input s6; input s7;
input p0; input p1; input p2; input p3; input p4; input p5; input p6; input p7;

let sib = [s0, s1, s2, s3, s4, s5, s6, s7];
let pb = [p0, p1, p2, p3, p4, p5, p6, p7];
let node = leaf;
for lvl in 0 .. 8 {
    let node = merkle_step(node, sib[lvl], pb[lvl]);
}
output node;
