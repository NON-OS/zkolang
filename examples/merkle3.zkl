// Membership in a depth three Merkle tree of MiMC two to one nodes. The leaf and three
// sibling hashes are given with the path bits that say, at each level, whether the leaf
// sits left or right. Each level orders the pair by its path bit and folds it through
// the compression, and the output is the root the path climbs to. A prover who knows a
// leaf and its authentication path can show it belongs under a public root.
// Run: zkolang merkle3.zkl
include "merkle.zkl";

input leaf;
input s0; input s1; input s2;
input p0; input p1; input p2;

let sib = [s0, s1, s2];
let pb = [p0, p1, p2];
let node = leaf;
for lvl in 0 .. 3 {
    let node = merkle_step(node, sib[lvl], pb[lvl]);
}
output node;
