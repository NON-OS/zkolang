/* Arrays, tuples and patterns (sections 7.6, 7.11 and 9), and `&mut` arguments (10.3). */

#[test]
fn arrays_index_and_update() {
    let mut a = [1u32, 2, 3, 4];
    a[2] = 30;
    let i: usize = 3;
    a[i] += 1;
    assert a[2] == 30 && a[3] == 5;
    assert a.len() == 4;
    let r = [7u8; 3];
    assert r == [7, 7, 7];
}

#[test]
#[should_fail]
fn dynamic_index_out_of_bounds_fails() {
    let a = [1u32, 2, 3];
    let i: usize = 3;
    let _x = a[i];
}

#[test]
fn enumerate_gives_indices() {
    let a = [5u32, 6, 7];
    let mut s: usize = 0;
    let mut t: u32 = 0;
    for (i, x) in a.enumerate() {
        s += i;
        t += x;
    }
    assert s == 3 && t == 18;
}

#[test]
fn tuples_and_patterns() {
    let t = (1u8, (true, 3u16));
    let (a, (b, c)) = t;
    assert a == 1 && b && c == 3;
    assert t.1.1 == 3;
    let [x, y] = [4u8, 5];
    assert x + y == 9;
}

#[test]
fn mut_arguments_write_back() {
    let mut a = [0u32; 3];
    bump(&mut a[1], 5);
    let mut p = (1u32, 2u32);
    swap(&mut p.0, &mut p.1);
    assert a[1] == 5 && p == (2, 1);
}

fn bump(x: &mut u32, by: u32) {
    x += by;
}

fn swap(a: &mut u32, b: &mut u32) {
    let t = a;
    a = b;
    b = t;
}
