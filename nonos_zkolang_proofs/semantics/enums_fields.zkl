/* Enum variants with fields (sections 6 and 7.11): built, compared, replaced whole. */

enum Shape {
    Circle(u32),
    Rect { w: u32, h: u32 },
    Empty,
}

impl Shape {
    fn area(self) -> u32 {
        match self {
            Shape::Circle(r) => 3 * r * r,
            Shape::Rect { w, h } => w * h,
            Shape::Empty => 0,
        }
    }

    fn square(side: u32) -> Self {
        Self::Rect { w: side, h: side }
    }

    fn grow(&mut self, by: u32) {
        self = match self {
            Shape::Circle(r) => Shape::Circle(r + by),
            Shape::Rect { w, h } => Shape::Rect { w: w + by, h: h + by },
            Shape::Empty => Shape::square(by),
        };
    }
}

const UNIT: Shape = Shape::Circle(1);

#[test]
fn variants_carry_their_fields() {
    let r = Shape::Rect { w: 3, h: 5 };
    assert r.area() == 15;
    assert Shape::Circle(2).area() == 12;
    assert Shape::square(4).area() == 16;
    assert Shape::Empty.area() == 0;
    assert UNIT.area() == 3;
}

#[test]
fn equality_compares_the_variant_and_its_fields() {
    assert Shape::Circle(2) == Shape::Circle(2);
    assert Shape::Circle(2) != Shape::Circle(3);
    assert Shape::Circle(0) != Shape::Empty;
    let r = Shape::Rect { w: 1, h: 2 };
    let s = Shape::Rect { h: 2, w: 1 };
    assert r == s;
}

#[test]
fn a_method_replaces_self() {
    let mut s = Shape::Circle(1);
    s.grow(2);
    assert s == Shape::Circle(3);
    let mut e = Shape::Empty;
    e.grow(5);
    assert e == Shape::square(5);
}

#[test]
#[should_fail]
fn an_overflow_in_the_taken_arm_fails() {
    let s = Shape::Rect { w: 65536, h: 65536 };
    let _a = s.area();
}
