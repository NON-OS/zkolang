/* Struct fields as places (section 8.2): written directly, through `&mut`, and in arrays. */

struct Point {
    x: u32,
    y: u32,
}

struct Pair(u8, i8);

struct Segment {
    from: Point,
    to: Point,
    tag: Pair,
}

const ORIGIN: Point = Point { x: 0, y: 0 };

fn shift(p: &mut Point, by: u32) {
    p.x += by;
    p.y = p.y + by;
}

#[test]
fn fields_are_written_through_places() {
    let mut p = Point { x: 1, y: 2 };
    shift(&mut p, 10);
    assert p == Point { x: 11, y: 12 };
    let mut s = Segment { from: p, to: ORIGIN, tag: Pair(0, 0) };
    s.to.x = 5;
    s.tag.1 -= 3;
    assert s.to.x == 5 && s.tag.1 == -3 && s.from.y == 12;
    let mut ps = [ORIGIN; 3];
    ps[1].y = 4;
    assert ps[1].y == 4 && ps[2] == ORIGIN;
}

#[test]
fn fields_are_evaluated_in_the_order_written() {
    let mut n = 0u32;
    let p = Point { y: { n += 1; n }, x: { n *= 10; n } };
    assert p.y == 1 && p.x == 10;
}
