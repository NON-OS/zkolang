/*
 * `match` on `field` and 64-bit values, an arm that leaves the function, and a failure
 * only in the arm that runs (sections 8.5 and 8.8).
 */

fn field_kind(f: field) -> u8 {
    match f {
        0 => 0,
        1 => 1,
        -1 => 2,
        _ => 3,
    }
}

fn wide(x: u64) -> u8 {
    match x {
        0..=4294967295 => 1,
        4294967296 => 2,
        18446744073709551615 => 4,
        _ => 3,
    }
}

fn first_even(xs: [u8; 4]) -> u8 {
    for x in xs {
        match x % 2 {
            0 => return x,
            _ => {}
        }
    }
    255
}

#[test]
fn field_and_wide_literals() {
    assert field_kind(0) == 0;
    assert field_kind(1) == 1;
    assert field_kind(0 - 1) == 2;
    assert field_kind(5) == 3;
    assert wide(7) == 1;
    assert wide(4294967296) == 2;
    assert wide(4294967297) == 3;
    assert wide(18446744073709551615) == 4;
}

#[test]
fn an_arm_may_leave_the_function() {
    assert first_even([1, 3, 4, 6]) == 4;
    assert first_even([1, 3, 5, 7]) == 255;
}

#[test]
fn a_failure_in_an_arm_not_taken_does_not_fail() {
    let x = 1u8;
    let y = match x {
        0 => x + 255,
        _ => 7,
    };
    assert y == 7;
}

#[test]
#[should_fail]
fn a_failure_in_the_taken_arm_fails() {
    let x = 0u8;
    let _y = match x {
        0 => x + 255 + 1,
        _ => 0,
    };
}
