/* Block-like forms that go on, and errors in heads and arms, each reported once. */
fn f(x: u8, a: [u8; 4], b: [u8; 4], c: bool) -> usize {
    match x {
        0 => if c { 1 } else { 2 }
        1 => 3,
        _ => 4,
    };
    match x { u8::MAX => 1, _ => 0 };
    if 0 < x < 10 { /*~ E0103 */
        let y = 1 +; /*~ E0100 */
    }
    while c { let z = 2 *; } /*~ E0100 E0100 */
    let v = match x {
        0 => 10 +, /*~ E0100 */
        1 => 20,
        _ => { let q = 1 +; q } /*~ E0100 */
    };
    let ref r = x; /*~ E0007 */
    let w = loop { 1 }; /*~ E0007 */
    for i in 0.. { } /*~ E0100 */
    while let Some(k) = x { } /*~ E0100 */
    const fn inner() {} /*~ E0100 */
    match x { 0 => a, _ => b }.len() + v
}
