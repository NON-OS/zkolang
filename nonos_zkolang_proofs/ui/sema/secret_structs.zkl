/* Secret flow through structs: fields keep their own labels, and a labelled field is a checked position. */
#![allow(unused)]
struct Point {
    x: u32,
    y: u32,
}

struct Note {
    owner: public field,
    value: secret u64,
    memo: u8,
}

fn fields(p: public u32, s: secret u32) -> public u32 {
    let a = Point { x: p, y: s };
    let b: public u32 = a.x;
    let c: public u32 = a.y; /*~ E0600 */
    b
}

fn notes(p: public field, s: secret field, v: public u64) -> public u8 {
    let n = Note { owner: s, value: v, memo: 1 }; /*~ E0600 */
    let m = Note { owner: p, value: v, memo: 2 };
    let w: public u64 = m.value; /*~ E0600 */
    let o: public field = m.owner;
    m.memo
}

fn written(p: public u32, s: secret u32) -> public u32 {
    let mut a = Point { x: p, y: p };
    a.y = s;
    let b: public u32 = a.x;
    a.y /*~ E0600 */
}

fn taken(s: secret Point) -> public u32 {
    let Point { x, y } = s;
    x /*~ E0600 */
}

fn main(p: public Point, s: secret Point) -> public u32 {
    p.x + declassify(s.y)
}

impl Note {
    fn memo(self) -> u8 {
        self.memo
    }

    fn worth(self) -> u64 {
        self.value
    }
}

fn methods(p: public field, v: public u64) -> public u64 {
    let n = Note { owner: p, value: v, memo: 3 };
    let m: public u8 = n.memo();
    n.worth() /*~ E0600 */
}
