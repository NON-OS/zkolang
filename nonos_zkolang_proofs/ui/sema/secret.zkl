/* Secret flow: a secret reaches a public position only through `declassify`. */
fn leak(s: secret u32) -> public u32 {
    s /*~ E0600 */
}

fn pass(x: u32) -> u32 { x }
fn needs(p: public u32) -> u32 { p }
fn keep(x: u32) -> u32 { let y: public u32 = x; y }

fn calls(s: secret u32, p: public u32) -> public u32 {
    let a: public u32 = pass(p);
    let b: public u32 = pass(s); /*~ E0600 */
    let c = needs(p) + keep(p);
    let d = needs(s); /*~ E0600 */
    let e = keep(s); /*~ E0600 */
    a + c
}

fn second(t: (u32, u32)) -> u32 { t.1 }
fn first(t: (public u32, secret u32)) -> u32 { t.0 }

fn parts(p: public u32, s: secret u32) -> public u32 {
    second((s, p)) + first((p, s))
}

fn branch(s: secret bool) -> public u32 {
    if s { 1 } else { 0 } /*~ E0600 */
}

fn assign(s: secret u32) {
    let mut x: public u32 = 0;
    x = s; /*~ E0600 */
    let mut y: public u32 = 0;
    if s > 3 { y = 1; } /*~ E0600 */
    let mut z: public u32 = 0;
    let t = s > 1 && { z = 1; true }; /*~ E0600 */
}

fn conditions(a: secret bool) -> public u32 {
    let mut x = 0;
    if a { } else if { x = 1; true } { }
    x /*~ E0600 */
}
