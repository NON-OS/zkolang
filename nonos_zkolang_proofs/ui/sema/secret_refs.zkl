/* Secret flow through `&mut` arguments, early exits and loops, and `main`'s labels. */
#![allow(unused)]
fn early(x: &mut u32, c: public bool) {
    if c { return; }
    x = 1;
}

fn in_loop(x: &mut u32, s: secret bool) {
    for i in 0..3 {
        if s { return; }
    }
    x = 5;
}

fn put(x: &mut u32, s: secret u32) { x = s; }
fn put_public(x: &mut public u32, s: secret u32) { x = s; } /*~ E0600 */

fn refs(w: secret u32, s: secret bool) -> public u32 {
    let mut y = w;
    early(&mut y, true);
    let mut z = 0;
    in_loop(&mut z, s);
    let mut q: public u32 = 0;
    put(&mut q, w); /*~ E0600 */
    y + z /*~ E0600 */
}

fn loops(s: secret bool, n: secret u32, i: secret usize) -> public u32 {
    let mut k = 0;
    for j in 0..4 {
        if s { break; }
        k += 1;
    }
    let mut m = 0;
    while m < n limit 8 { m += 1; }
    let mut a = [0u32; 4];
    a[i] = 1;
    k + m + a[0] /*~ E0600 */
}

fn open(s: secret u32, p: public u32) -> public u32 {
    declassify(s) + declassify(p) /*~ W0006 */
}

fn main(
    a: public u32,
    b: u32, /*~ E0601 */
    w: secret u32,
) -> u32 {
    a + b + w /*~ E0600 */
}
