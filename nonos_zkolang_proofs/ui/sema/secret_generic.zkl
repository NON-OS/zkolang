/* Secret flow through generic structs and enums: each instance keeps its fields' labels. */
#![allow(unused)]
struct Note<T> {
    owner: public field,
    value: T,
}

enum Maybe<T> {
    Just(T),
    Nothing,
}

fn owner(s: secret field, v: public u8) -> public u8 {
    let n = Note { owner: s, value: v }; /*~ E0600 */
    n.value
}

fn value(s: secret u8) -> public u8 {
    let n = Note { owner: 1, value: s };
    n.value /*~ E0600 */
}

fn chosen(s: secret u8, p: public u8) -> public u8 {
    let m = Maybe::Just(s);
    match m {
        Maybe::Just(_) => p,
        Maybe::Nothing => 0,
    }
}
