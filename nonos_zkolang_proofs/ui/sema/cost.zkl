/* Cost warnings (section 15.3) at the default thresholds: a loop past 1024 iterations, a runtime index into an array past 64 elements. */
fn long_loop() -> u32 {
    let mut s = 0u32;
    for i in 0..2000u32 { /*~ W0100 */
        s = s.wrapping_add(i);
    }
    for i in 0..1024u32 {
        s = s.wrapping_add(i);
    }
    s
}

fn waits(x: u16) -> u16 {
    let mut y = x;
    while y > 0 limit 5000 { /*~ W0100 */
        y -= 1;
    }
    y
}

fn read(a: [u8; 100], i: usize) -> u8 {
    a[i] /*~ W0101 */
}

fn read_short(a: [u8; 64], i: usize) -> u8 {
    a[i] + a[99 - 36]
}

fn write(a: [(u8, [u8; 65]); 2], i: usize) -> [(u8, [u8; 65]); 2] {
    let mut b = a;
    b[i].1[i] = 1; /*~ W0101 */
    b
}

#[allow(cost)]
fn allowed(a: [u8; 100], i: usize) -> u8 {
    a[i]
}
