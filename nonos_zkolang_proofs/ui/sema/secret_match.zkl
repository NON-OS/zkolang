/*
 * Secret flow through enums and `match`: a secret scrutinee or guard makes the choice of
 * arm secret, so its value and what its arm writes are secret; a public one does not.
 */
#![allow(unused)]
enum Choice {
    A(u32),
    B,
}

fn scrutinee(s: secret u8) -> public u8 {
    let r = match s {
        0 => 1,
        _ => 2,
    };
    r /*~ E0600 */
}

fn taken_field(p: public u8, s: secret u32) -> public u32 {
    let c = Choice::A(s);
    match c {
        Choice::A(x) => {
            let y: public u32 = x; /*~ E0600 */
            y
        }
        Choice::B => 0,
    }
}

fn chosen_under_secret(p: public u32, s: secret bool) -> public u32 {
    let c = if s { Choice::A(p) } else { Choice::B };
    match c { /*~ E0600 */
        Choice::A(x) => x,
        Choice::B => 0,
    }
}

fn written_under_secret(s: secret u8) -> public u8 {
    let mut out: public u8 = 0;
    match s {
        0 => out = 1, /*~ E0600 */
        _ => {}
    }
    out
}

fn written_under_guard(p: public u8, s: secret u8) -> public u8 {
    let mut out: public u8 = 0;
    match p {
        x if x == s => out = 1, /*~ E0600 */
        _ => {}
    }
    out
}

fn public_choice(p: public u8) -> public u8 {
    let mut out: public u8 = 0;
    match p {
        0 => out = 1,
        n if n > 5 => out = 2,
        _ => {}
    }
    out
}

fn declassified(s: secret u8) -> public u8 {
    declassify(match s {
        0 => 1,
        _ => 2,
    })
}
