/* Struct mistakes: each reported once, where it is made. */
#![allow(unused)]
struct Point {
    x: u32,
    y: u32,
}

struct Pair(u8, u8);

struct Twice {
    a: u8,
    a: u8, /*~ E0314 */
}

struct Loop { /*~ E0313 */
    next: Loop,
}

mod geo {
    pub struct Hidden {
        pub open: u8,
        shut: u8,
    }

    pub fn make() -> Hidden {
        Hidden { open: 1, shut: 2 }
    }
}

fn f(p: Point, h: geo::Hidden) -> u32 {
    let a = Point { x: 1 }; /*~ E0315 */
    let b = Point { x: 1, y: 2, x: 3 }; /*~ E0314 */
    let c = Point { x: 1, y: 2, z: 3 }; /*~ E0308 */
    let d = Point { x: true, y: 2 }; /*~ E0300 */
    let e = Pair { a: 1 }; /*~ E0205 */
    let g = Point(1, 2); /*~ E0205 */
    let i = h.open;
    let j = h.shut; /*~ E0202 */
    let k = geo::Hidden { open: 1, shut: 2 }; /*~ E0202 */
    let l = p.z; /*~ E0308 */
    let m = p.0; /*~ E0308 */
    let Point { x, .. } = p;
    let Point { y } = p; /*~ E0315 */
    let Pair(u, v, w) = Pair(1, 2); /*~ E0402 */
    let Pair(s, t) = p; /*~ E0402 */
    p.x + p.y
}
